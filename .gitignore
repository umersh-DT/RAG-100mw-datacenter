# Allow raw data directories and PDF files for cloud deployment
!/data/
!/data/raw/
!/data/raw/**

# Processed Data JSON cache (Ignored, generated dynamically)
/data/processed/chunks.json
!/data/processed/.gitkeep

# Output Artifacts & Indices (Ignored, generated dynamically on startup)
/output/chroma_db/
/output/bm25_index.pkl
/output/*
!/output/.gitkeep

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/

# Environment Variables & API Keys
.env
*.env

# Python Bytecode & Caches
__pycache__/
*.pyc
.pytest_cache/

# OS Artifacts
.DS_Store
Thumbs.db